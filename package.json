{
  "name": "efrei-logistique-perf",
  "version": "1.0.0",
  "private": true,
  "description": "Cellule performance d'Efrei Logistique : depot legacy, generateur de donnees, banc de mesure. Module Algorithmie comparative, M2 Dev Manager Full Stack, EFREI Bordeaux, 2026-2027.",
  "type": "module",
  "scripts": {
    "ban": "tsx data/generateur/ban.ts",
    "data": "tsx data/generateur/generer.ts",
    "mois": "tsx data/generateur/mois.ts",
    "chrono": "tsx legacy/bin/chrono.ts",
    "batch": "tsx legacy/bin/chrono.ts --etape toutes",
    "bench": "node --expose-gc --import tsx bench/harness.ts",
    "bench:naif": "tsx bench/bench-naif.ts",
    "couples": "tsx bench/couples.ts",
    "courbe": "tsx bench/courbe.ts",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "verifier": "tsx outils/verifier.ts",
    "exactitude": "node --expose-gc --import tsx bench/exactitude.ts",
    "pont": "tsx bench/pont.ts",
    "voyageur": "tsx bench/voyageur.ts",
    "graphe": "tsx bench/graphe-infos.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13"
  }
}
